{
	"expo": {
		"name": "Shelfie",
		"slug": "shelfie",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/images/icon.png",
		"scheme": "shelfie",
		"userInterfaceStyle": "automatic",
		"ios": {
			"icon": "./assets/expo.icon",
			"bundleIdentifier": "com.georgebarnes.shelfie"
		},
		"android": {
			"adaptiveIcon": {
				"backgroundColor": "#E6F4FE",
				"foregroundImage": "./assets/images/android-icon-foreground.png",
				"backgroundImage": "./assets/images/android-icon-background.png",
				"monochromeImage": "./assets/images/android-icon-monochrome.png"
			},
			"predictiveBackGestureEnabled": false,
			"package": "com.georgebarnes.shelfie"
		},
		"web": {
			"output": "server",
			"favicon": "./assets/images/favicon.png"
		},
		"plugins": [
			"expo-router",
			[
				"expo-splash-screen",
				{
					"backgroundColor": "#208AEF",
					"image": "./assets/images/splash-icon.png",
					"imageWidth": 76
				}
			],
			[
				"expo-image-picker",
				{
					"cameraPermission": "Shelfie uses your camera to photograph your fridge so it can spot your ingredients.",
					"photosPermission": "Shelfie uses your photo library so you can pick a picture of your fridge.",
					"microphonePermission": false
				}
			],
			"expo-image"
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		}
	}
}
